---
interface Props {
  title: string;
  description?: string | undefined;
}

const { title, description } = Astro.props;
---

<header class="mb-8">
  {/* the rule runs out from the heading, echoing the route line in the hero */}
  <div class="rule-out flex items-center gap-4">
    <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl lg:text-4xl">
      {title}
    </h2>
  </div>
  {
    description && (
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground text-pretty sm:text-base">
        {description}
      </p>
    )
  }
</header>
