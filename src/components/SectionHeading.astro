---
interface Props {
  title: string;
  description?: string | undefined;
  /** Optional short kicker above the heading. Omit it rather than repeating the title. */
  eyebrow?: string | undefined;
}

const { title, description, eyebrow } = Astro.props;
---

<header class="mb-7">
  {
    eyebrow && (
      <p class="text-xs font-medium tracking-[0.14em] text-primary uppercase">
        {eyebrow}
      </p>
    )
  }
  <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl lg:text-4xl">
    {title}
  </h2>
  {
    description && (
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground text-pretty sm:text-base">
        {description}
      </p>
    )
  }
</header>
