---
import Container from "@/components/Container.astro";
import Icon from "@/components/Icon.astro";
import BrandGithub from "@/components/icons/BrandGithub.astro";
import BrandLinkedin from "@/components/icons/BrandLinkedin.astro";
import { buttonClass } from "@/lib/button";
import { contact, profile } from "@/data/profile";

const year = new Date().getFullYear();
---

<footer class="no-print mt-auto border-t bg-muted/20">
  <Container class="py-8 sm:py-10">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div class="min-w-0">
        <p class="text-sm font-semibold text-primary">{profile.handle}</p>
        <p class="mt-2 max-w-md text-sm text-muted-foreground text-pretty">
          Built with Astro and Tailwind CSS. Statically generated and hosted on
          GitHub Pages.
        </p>
        <p class="mt-3 text-xs text-muted-foreground">
          © {year} {profile.name}. All rights reserved.
        </p>
      </div>

      <div class="flex items-center gap-1">
        <a
          href={`mailto:${contact.email}`}
          aria-label="Email"
          class={buttonClass({ variant: "ghost", size: "icon" })}
        >
          <Icon name="mail" class="size-4" />
        </a>
        <a
          href={contact.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class={buttonClass({ variant: "ghost", size: "icon" })}
        >
          <BrandGithub class="size-4" />
        </a>
        <a
          href={contact.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class={buttonClass({ variant: "ghost", size: "icon" })}
        >
          <BrandLinkedin class="size-4" />
        </a>
        <a
          href="#about"
          class={buttonClass({ variant: "outline", size: "sm", class: "ml-2" })}
        >
          <Icon name="arrow-up" class="size-3.5" />
          Top
        </a>
      </div>
    </div>
  </Container>
</footer>
