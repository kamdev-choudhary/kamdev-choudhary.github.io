---
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Badge from "@/components/Badge.astro";
import Icon from "@/components/Icon.astro";
import { education } from "@/data/profile";
---

<Section id="education" class="border-t">
  <SectionHeading
    title="Education"
    description="Formal academics, most recent first."
  />

  <div class="grid gap-4 md:grid-cols-3 md:gap-5">
    {
      education.map((entry, index) => (
        <article
          class="reveal raised flex flex-col rounded-xl border bg-card p-5 transition-colors hover:border-primary/40 print-break"
          style={`--reveal-delay: ${index * 80}ms`}
        >
          <div class="mb-3 flex items-start justify-between gap-3">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-md border bg-muted/50">
              <Icon name="graduation-cap" class="size-4 text-primary" />
            </span>
            <Badge variant="outline" class="figure">{entry.year}</Badge>
          </div>

          <h3 class="text-base font-semibold text-balance">{entry.level}</h3>
          {entry.stream && (
            <p class="mt-1 text-sm text-muted-foreground text-pretty">
              {entry.stream}
            </p>
          )}

          <p class="mt-3 text-sm text-muted-foreground text-pretty">
            {entry.institute}
          </p>

          <p class="mt-auto pt-4 text-sm">
            <span class="text-muted-foreground">{entry.gradeSystem}: </span>
            <span class="figure font-semibold text-data">{entry.grade}</span>
          </p>
        </article>
      ))
    }
  </div>
</Section>
