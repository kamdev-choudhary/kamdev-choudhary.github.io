---
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Panel from "@/components/Panel.astro";
import { computeStats, profile } from "@/data/profile";

/** Figures are derived in data/stats.ts and recomputed at build time. */
const stats = computeStats();
---

<Section id="about">
  <SectionHeading
    title="About"
    description="Where the academic work ends and the engineering begins."
  />

  <div class="grid gap-6 lg:grid-cols-5 lg:items-start lg:gap-8">
    <Panel class="raised lg:col-span-3" bodyClass="space-y-4 p-5 sm:p-6">
      {
        profile.about.map((para) => (
          <p class="max-w-prose text-sm leading-relaxed text-muted-foreground text-pretty sm:text-base">
            {para}
          </p>
        ))
      }
    </Panel>

    {/* a readout rather than a row of tiles: label left, figure right */}
    <dl class="raised divide-y rounded-xl border bg-card lg:col-span-2">
      {
        stats.map((stat) => (
          <div class="flex items-baseline justify-between gap-4 px-5 py-3.5">
            <dt class="text-sm text-muted-foreground">{stat.label}</dt>
            <dd class="figure text-lg font-semibold text-data">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Section>
