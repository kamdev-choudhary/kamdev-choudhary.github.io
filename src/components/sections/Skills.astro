---
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Panel from "@/components/Panel.astro";
import TechBadge from "@/components/TechBadge.astro";
import { skills } from "@/data/profile";
---

<Section id="skills" class="border-t bg-muted/20">
  <SectionHeading
    title="Skills"
    description="What I reach for, grouped by where it lives in the stack."
  />

  <Panel class="reveal raised" bodyClass="p-0">
    <div class="grid divide-y sm:grid-cols-2 sm:divide-x lg:grid-cols-3">
      {
        skills.map((group) => (
          <div class="p-5">
            <p class="mb-3 text-sm font-semibold text-primary capitalize">
              {group.label}
            </p>
            <ul class="flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <li>
                  <TechBadge name={item} />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Panel>
</Section>
