---
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Badge from "@/components/Badge.astro";
import Icon from "@/components/Icon.astro";
import { certificates } from "@/data/profile";
---

<Section id="certificates" class="border-t bg-muted/20">
  <SectionHeading
    title="Certificates"
    description="Courses and programs completed, with verification links."
  />

  <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    {
      certificates.map((certificate) => (
        <article class="flex flex-col rounded-xl border bg-card p-5 transition-colors hover:border-primary/40 print-break">
          <div class="mb-3 flex items-start justify-between gap-3">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-md border bg-muted/50">
              <Icon name="award" class="size-4 text-primary" />
            </span>
            <Badge variant="outline">
              <Icon
                name={certificate.mode === "Online" ? "globe" : "map-pin"}
                class="size-3"
              />
              {certificate.mode}
            </Badge>
          </div>

          <h3 class="text-base font-semibold text-balance">
            {certificate.name}
          </h3>
          <p class="mt-1 text-sm text-muted-foreground text-pretty">
            {certificate.institute}
          </p>

          <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
            <span class="flex items-center gap-1.5">
              <Icon name="clock" class="size-3.5 shrink-0" />
              {certificate.duration}
            </span>
            <span>{certificate.period}</span>
          </p>

          {certificate.skills.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {certificate.skills.map((skill) => (
                <li>
                  <Badge variant="secondary">{skill}</Badge>
                </li>
              ))}
            </ul>
          )}

          {certificate.notes.length > 0 && (
            <ul class="mt-3 space-y-1.5">
              {certificate.notes.map((note) => (
                <li class="flex gap-2 text-sm leading-relaxed text-muted-foreground text-pretty">
                  <span class="text-primary/60" aria-hidden="true">
                    &rsaquo;
                  </span>
                  {note}
                </li>
              ))}
            </ul>
          )}

          <div class="mt-auto pt-4">
            <div class="mb-3 h-px bg-border"></div>
            <ul class="space-y-1.5">
              {certificate.links.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-start gap-1.5 text-xs text-primary underline-offset-4 hover:underline"
                  >
                    <span class="min-w-0 break-words">
                      {link.title ?? link.type}
                    </span>
                    <Icon
                      name="arrow-up-right"
                      class="mt-0.5 size-3.5 shrink-0 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                    />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</Section>
