---
import { cn } from "@/lib/utils";

const VARIANTS = {
  secondary: "border-transparent bg-secondary text-secondary-foreground",
  outline: "border-border text-muted-foreground",
} as const;

interface Props {
  variant?: keyof typeof VARIANTS | undefined;
  class?: string | undefined;
}

const { variant = "secondary", class: className } = Astro.props;
---

<span
  class={cn(
    "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-normal whitespace-nowrap sm:text-xs",
    VARIANTS[variant],
    className,
  )}
>
  <slot />
</span>
