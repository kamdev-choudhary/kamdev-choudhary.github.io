# Web3Forms access key for the contact form (https://web3forms.com).
#
# Optional. A working key is committed in src/lib/site.ts — Web3Forms keys
# are public by design, since they live in client-side markup and can only
# deliver to the one inbox they are bound to. Set this only to override it.
#
# With no key at all the contact form renders disabled, showing a direct
# email link in its place.
PUBLIC_WEB3FORMS_KEY=
